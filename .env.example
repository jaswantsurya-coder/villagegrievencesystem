# Supabase Configuration (Required)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Help Portal Links (Optional)
# VITE_REQUEST_ADMIN_URL=https://request.gramseva.in
# VITE_REPORT_BUGS_URL=https://support.gramseva.in
# VITE_FEEDBACK_URL=https://feedback.gramseva.in

# ─── Server-side only (Vercel Environment Variables) ───────────────────────
# These are used by Vercel Serverless Functions (api/ directory).
# Do NOT prefix with VITE_ — they must stay server-side only.
# Set these in Vercel Dashboard → Project Settings → Environment Variables.
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
