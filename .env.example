# ─── GramSeva Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values

# ─── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=https://your-project.supabase.co

# ─── Brevo Email (SMTP API) ─────────────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=admin@gramseva.in
BREVO_SENDER_NAME=GramSeva

# ─── Firebase (Backend FCM Push Notifications) ──────────────────────────────
# Paste the entire Firebase service account JSON as a single line
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"grievance-system-e72c5",...}

# ─── Firebase Web Client (Google Auth & FCM Push) ───────────────────────────
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
VITE_FIREBASE_VAPID_KEY=your-vapid-key

# ─── Notification API Security ──────────────────────────────────────────────
# Secret key for authenticating notification API calls
# Can be the same as SUPABASE_SERVICE_ROLE_KEY or a separate secret
NOTIFICATION_API_SECRET=your-notification-api-secret

# ─── Vercel Cron Security ───────────────────────────────────────────────────
# Set this in Vercel Dashboard → Settings → Environment Variables
CRON_SECRET=your-cron-secret

# ─── WhatsApp (Future Integration) ──────────────────────────────────────────
# WHATSAPP_ENABLED=false
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
