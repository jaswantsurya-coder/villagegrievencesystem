# GramSeva AI Inference Server — Environment Variables
# Copy this to .env and fill in your values

# ─── Supabase (Auxiliary Cluster — Grievances DB) ─────────────────────────────
SUPABASE_URL=https://dtucrczgagpzjbbrwqit.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── API Authentication ──────────────────────────────────────────────────────
# Phase 1: Simple shared key (set same value in Vercel env vars)
AI_API_KEY=your_strong_api_key_here

# Phase 2: HMAC request signing (optional, for public endpoints)
AI_HMAC_SECRET=your_hmac_secret_here

# ─── Hugging Face ────────────────────────────────────────────────────────────
# Optional: Set if Qwen2.5-1.5B-Instruct requires auth (it's public, so usually not needed)
HF_TOKEN=
# Local cache directory for downloaded models
HF_HOME=/opt/gramseva/models

# ─── Model Configuration ─────────────────────────────────────────────────────
MODEL_VERSION=GramSeva-Qwen2.5-v1
ADAPTER_PATH=./gramseva_model
# Directory for new adapter versions (hot-swap)
MODELS_DIR=/opt/gramseva/models/adapters

# ─── Server Configuration ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKER_ID=oracle-arm-1
# Max concurrent inference requests
MAX_CONCURRENT=1
